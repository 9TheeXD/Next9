# Copy to .env.local for local development; set the same names in Vercel → Project → Settings →
# Environment Variables for production.

# ---- Database (Turso / libSQL) ----
# Production: the Turso database made from the VPS data (see DEPLOY.md). Leave empty locally to use
# ../data-dev/next9.db (create it with: npm run db:import).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Cloudflare R2 (photos, member pictures) ----
CF_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=assets

# ---- Passwords ----
EDITOR_PASSWORD=
PHOTOS_PASSWORD=
TOILET_PASSWORD=
# Signs album unlock tokens. Any long random string; keep it the same across deploys.
ALBUM_TOKEN_SECRET=

# ---- Google Sheets (inert, building, students) ----
# The whole service-account key file as one line of JSON (was service-account.json).
GOOGLE_SERVICE_ACCOUNT_JSON=
INERT_SHEET_ID=
INERT_SHEET_RANGE=
INERT_LOOKUP_SHEET_RANGE=
INERT_SHEET_JUNIOR_RANGE=
INERT_LOOKUP_SHEET_JUNIOR_RANGE=
INERT_SHEET_HIGH_RANGE=
INERT_LOOKUP_SHEET_HIGH_RANGE=
STUDENTS_SHEET_ID=
BUILDING_SHEET_ID=

# ---- LINE bot (webhook: https://<site>/api/line/webhook) ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Dialogflow agent's service-account key as one line of JSON (was lineBot/sdh-next9-chatbot-*.json).
DIALOGFLOW_CREDENTIALS_JSON=
DIALOGFLOW_PROJECT_ID=sdh-next9-chatbot

# ---- Misc ----
# Public address of the site, used in link previews.
SITE_ORIGIN=https://next9.yumistack.net
# Vercel sends it to the daily cron; any random string.
CRON_SECRET=

# Local development only: R2 writes go to ../.dev-r2 instead of the real bucket.
# NEXT9_DEV_READONLY=1
