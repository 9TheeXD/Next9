# Copy to .env.local for local development; set the same names in Vercel (Project → Settings →
# Environment Variables) for production.

# Database (Turso). Empty locally = data/assess.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sign-in (NextAuth + Google)
NEXTAUTH_URL=https://assess-row-sdh.vercel.app
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET_KEY=

# Admin login (credentials form on /admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Daily backup to R2 (GET /api/cron/backup, Vercel cron)
CF_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=assets
CRON_SECRET=
