# Set in Vercel (used at build time by expo export). /api is proxied to the admin-web project by
# the rewrite in vercel.json (https://next9-ciga-admin.vercel.app), so the app needs no CORS. If the
# admin-web project has another address, change that one line in vercel.json.
EXPO_PUBLIC_API_URL=/api
# Optional: admin-web's address (where the web onboarding finishes) and this app's own address
# (QR codes when not opened in a browser).
EXPO_PUBLIC_ADMIN_URL=https://next9-ciga-admin.vercel.app/
EXPO_PUBLIC_APP_URL=https://next9-ciga-app.vercel.app
