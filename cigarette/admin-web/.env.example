# Copy to .env.local for local development; set the same names in Vercel for production.

# Postgres (Supabase): the "Transaction pooler" connection string (port 6543), for serverless.
DATABASE_URL=
PG_POOL_MAX=3

JWT_SECRET=
ADMIN_PASSWORD=
# Origin of the mobile web app allowed to call the API
CORS_ORIGIN=https://app-ciga-next9.yumistack.net

# Firebase Admin (push notifications): the service-account key JSON on one line
FIREBASE_SERVICE_ACCOUNT=

# Scheduler secret: cron-job.org calls /api/cron/smart-push?key=<CRON_SECRET> every 5 minutes
CRON_SECRET=

# Uploaded sounds (Cloudflare R2)
CF_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=assets
SOUNDS_PUBLIC_BASE_URL=https://cdn.yumistack.net
